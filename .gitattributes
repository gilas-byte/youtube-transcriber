# Normalise everything to LF in the repository.
* text=auto eol=lf

# These MUST be LF: they run inside the Linux container or as shell scripts.
*.py        text eol=lf
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
Dockerfile  text eol=lf
Dockerfile.* text eol=lf
.env.example text eol=lf
*.service   text eol=lf

# These are Windows-native and want CRLF.
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Never touch binaries.
*.png binary
*.jpg binary
*.db  binary
