# ============================================================
#  YouTube Transcripter - configuration
#  Copy this file to `.env` and tweak whatever you need.
# ============================================================

# ------------------------------------------------------------
#  RUN MODE - CPU or GPU
#  This is the ONLY thing you change to switch between them.
#  Easier: run `./mode.sh gpu` (Linux/macOS) or `.\mode.ps1 gpu` (Windows).
#  Either way, the command to start stays `docker compose up -d`.
# ------------------------------------------------------------
COMPOSE_PATH_SEPARATOR=:

# CPU - works on every machine, no extra setup:
COMPOSE_FILE=docker-compose.yml

# NVIDIA GPU - comment the line above, uncomment the line below:
#COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# --- Storage (paths inside the container) ---
DB_PATH=/app/data/transcripts.db
MODELS_DIR=/app/models
DOWNLOADS_DIR=/app/downloads

# --- Whisper ---
# WHISPER_DEVICE: auto | cuda | cpu
# `auto` uses the GPU when the image and hardware support it, CPU otherwise.
WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE: auto | float16 | int8_float16 | int8 | float32
WHISPER_COMPUTE_TYPE=auto
# DEFAULT_MODEL: tiny | base | small | medium | large-v3 | turbo
DEFAULT_MODEL=small
# Beam size: higher = slightly better, slower. 1 = greedy (fastest)
WHISPER_BEAM_SIZE=5
# Voice Activity Detection: skips silence, usually faster + cleaner
WHISPER_VAD=true

# --- Safety limits ---
MAX_DURATION_MINUTES=180

# --- History ---
HISTORY_LIMIT=50

# --- Linux only: match the container user to your host user ---
# Uncomment and set these if you hit "permission denied" on data/ or models/.
# Find your values with: id -u  and  id -g
#UID=1000
#GID=1000
